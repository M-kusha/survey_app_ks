rules_version = '2';

// EchoMeet security rules.
//
// The app is multi-tenant: every user belongs to a company, and nothing should
// ever cross that boundary. The client-side role checks in the Flutter code
// (FirebaseServices.fetchAdminStatus and friends) only decide which buttons to
// draw — they are not a security boundary and are trivially bypassed. This file
// is the boundary.
//
// Two rules carry most of the weight:
//   * a user can never change their own role
//   * a participant can never write their own score
//
// Note on cost: helper functions below read the caller's profile, company and
// ban record. Firestore caches repeated access calls in one evaluation; the
// rules stay below the 10-call limit for a single-document request.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------

    function signedIn() {
      return request.auth != null;
    }

    // A trusted account-deletion function creates this short-lived lock before
    // enumerating data. Existing sessions may retain valid ID tokens until Auth
    // is deleted, so every client write must fail while the lock exists.
    function accountActive() {
      return signedIn()
        && !exists(
          /databases/$(database)/documents/accountDeletionLocks/$(uid())
        );
    }

    function emailVerified() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    function uid() {
      return request.auth.uid;
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(uid())).data;
    }

    function hasProfile() {
      return emailVerified()
        && exists(/databases/$(database)/documents/users/$(uid()));
    }

    function myCompanyId() {
      return profile().companyId;
    }

    function belongsToCompany(companyId) {
      return hasProfile() && myCompanyId() == companyId;
    }

    function canonicalProfileImagePath(userId) {
      return 'profile_images/' + userId + '/avatar.jpg';
    }

    function validMemberProjection(data) {
        return data.keys().hasOnly([
          'fullName', 'profileImage', 'profileImageRevision', 'companyId',
          'role', 'membership'
        ])
        && data.keys().hasAll([
          'fullName', 'companyId', 'role', 'membership'
        ])
        && data.fullName is string
        && data.fullName.size() > 0
        && data.fullName.size() <= 120
        && data.companyId is string
        && data.companyId.size() > 0
        && data.role in ['user', 'admin', 'moderator', 'superadmin']
        && data.membership in ['active', 'pending']
        && (!('profileImage' in data) || data.profileImage is string)
        && (
          !('profileImageRevision' in data)
          || (
            data.profileImageRevision is int
            && data.profileImageRevision >= 0
            && data.profileImageRevision <= 2147483647
          )
        );
    }

    function memberProjectionEquals(directoryData, userData) {
      return directoryData.fullName == userData.fullName
        && directoryData.companyId == userData.companyId
        && directoryData.role == userData.role
        && directoryData.membership == membershipOf(userData)
        && (
          (
            !('profileImage' in directoryData)
            && !('profileImage' in userData)
          )
          || (
            'profileImage' in directoryData
            && 'profileImage' in userData
            && directoryData.profileImage == userData.profileImage
          )
        )
        && (
          (
            !('profileImageRevision' in directoryData)
            && !('profileImageRevision' in userData)
          )
          || (
            'profileImageRevision' in directoryData
            && 'profileImageRevision' in userData
            && directoryData.profileImageRevision
                 == userData.profileImageRevision
          )
        );
    }

    function memberProjectionSyncedAfter(userId, userData) {
      return userData.companyId == ''
        ? !existsAfter(
            /databases/$(database)/documents/memberDirectory/$(userId)
          )
        : (
          existsAfter(
            /databases/$(database)/documents/memberDirectory/$(userId)
          )
          && validMemberProjection(getAfter(
            /databases/$(database)/documents/memberDirectory/$(userId)
          ).data)
          && memberProjectionEquals(
            getAfter(
              /databases/$(database)/documents/memberDirectory/$(userId)
            ).data,
            userData
          )
        );
    }

    // Two levels of privilege, deliberately separate.
    //
    // `isStaff` is about *content* — writing surveys and meetings, seeing
    // results, marking written answers. Moderators are staff.
    //
    // `isCompanyAdmin` is about *people* — roles, bans, removals. Moderators
    // are not, and that is the whole point: a moderator who can promote is an
    // admin with extra steps. This split is enforced here rather than in the
    // UI, because a rule is the only version of it an attacker cannot skip.
    function isStaff() {
      return hasProfile()
        && profile().role in ['admin', 'moderator', 'superadmin'];
    }

    function isCompanyAdmin() {
      return hasProfile()
        && profile().role in ['admin', 'superadmin'];
    }

    // Same company as the caller, *and* entitled to be there.
    //
    // A null companyId never matches, so documents written before companyId
    // existed stay invisible rather than public. Pending and banned members
    // fail here too, which is the whole access model in one function: they can
    // sign in, keep their notes and go and find another company, but the
    // content of this one is closed to them.
    function sameCompany(companyId) {
      return activeIn(companyId);
    }

    /// Content privilege inside one company. Named `adminOf` throughout the
    /// content rules below; it includes moderators.
    function adminOf(companyId) {
      return isStaff() && sameCompany(companyId);
    }

    /// People privilege inside one company. Admins and the owner only.
    function companyAdminOf(companyId) {
      return isCompanyAdmin() && sameCompany(companyId);
    }

    function companyExists(companyId) {
      return companyId != null
        && companyId != ''
        && exists(/databases/$(database)/documents/companies/$(companyId));
    }

    // Once a company's grace period expires, only the Admin SDK purge may
    // touch its content. This closes the window where clients could create new
    // children while the scheduled purge was enumerating old ones.
    function companyAcceptsContent(companyId) {
      return companyExists(companyId)
        && (
          !('deletionScheduledFor' in get(
            /databases/$(database)/documents/companies/$(companyId)
          ).data)
          || request.time < get(
            /databases/$(database)/documents/companies/$(companyId)
          ).data.deletionScheduledFor
        );
    }

    function companyAcceptsJoins(companyId) {
      return companyExists(companyId)
        && !('deletionScheduledFor' in get(
          /databases/$(database)/documents/companies/$(companyId)
        ).data);
    }

    // ---------- membership ----------
    //
    // A ban is a document under the company, not a flag on the person:
    // `companies/{c}/bans/{uid}`. That is what lets the account outlive it. The
    // banned member keeps their login, their notes and their ability to go and
    // join somewhere else, and the company keeps a list it can work from — one
    // it does not lose the moment that person moves on, which a flag on the
    // user document would.
    function bannedFrom(companyId) {
      return companyId != null
        && companyId != ''
        && exists(
             /databases/$(database)/documents/companies/$(companyId)/bans/$(uid())
           );
    }

    // Joining is either immediate or it waits, and the company decides which.
    // A missing `joinPolicy` reads as open, so companies created before this
    // existed keep behaving exactly as they did.
    function joinPolicyOf(companyId) {
      return 'joinPolicy' in get(
               /databases/$(database)/documents/companies/$(companyId)
             ).data
        ? get(/databases/$(database)/documents/companies/$(companyId))
            .data.joinPolicy
        : 'open';
    }

    // What a new joiner's membership must be set to. Written as a rule rather
    // than trusted from the client: otherwise anyone could join a company that
    // requires approval and mark themselves approved in the same write.
    function requiredJoinStatus(companyId) {
      return joinPolicyOf(companyId) == 'open' ? 'active' : 'pending';
    }

    // Absent means active, so accounts that predate approvals are unaffected.
    function membershipOf(data) {
      return 'membership' in data ? data.membership : 'active';
    }

    // Full access to a company's content: a member, approved, not banned.
    function activeIn(companyId) {
      return hasProfile()
        && companyAcceptsContent(companyId)
        && myCompanyId() == companyId
        && membershipOf(profile()) == 'active'
        && !bannedFrom(companyId);
    }

    // UID is the identity. Display names stored on responses and votes are
    // historical snapshots, but the client may write only its own current,
    // active projection from the same company.
    function callerUsesCanonicalMemberName(companyId, claimedName) {
      return claimedName is string
        && exists(
          /databases/$(database)/documents/memberDirectory/$(uid())
        )
        && validMemberProjection(get(
          /databases/$(database)/documents/memberDirectory/$(uid())
        ).data)
        && get(
          /databases/$(database)/documents/memberDirectory/$(uid())
        ).data.companyId == companyId
        && get(
          /databases/$(database)/documents/memberDirectory/$(uid())
        ).data.membership == 'active'
        && get(
          /databases/$(database)/documents/memberDirectory/$(uid())
        ).data.fullName == claimedName;
    }

    // ---------- public company directory ----------

    // Only this deliberately minimal projection is public; the authoritative
    // company document (owner UID, deletion lifecycle and timestamps) is not.
    match /companyDirectory/{companyId} {
      allow read: if true;

      // Creation and every administrative change are trusted-only. In
      // particular, a client cannot change the public join policy without the
      // authoritative company mutation and immutable activity entry.
      allow create, update, delete: if false;
    }

    // ---------- companies ----------

    match /companies/{companyId} {
      allow get: if belongsToCompany(companyId);
      allow list: if false;

      // Creation, settings, ownership, closure and destruction all go through
      // trusted functions so the state change and activity event cannot split.
      // This includes the optional server-owned `ownershipTransfer` offer on
      // the company document: clients may read it with the company, but may
      // never add, amend, accept or remove it directly.
      allow create, update, delete: if false;

      // ---------- bans ----------
      //
      // One document per banned person, under the company that banned them.
      match /bans/{bannedUserId} {
        // The person themselves can read their own ban, which is how the app
        // can say "you are banned from Acme" instead of failing silently and
        // looking broken. Staff can read the whole list — that is the list an
        // admin unbans people from.
        allow read: if signedIn()
          && (bannedUserId == uid() || adminOf(companyId));

        // Ban, unban and erase are trusted operations. A direct client batch
        // could otherwise perform the privilege change without its activity
        // record.
        allow create, update, delete: if false;
      }

      // ---------- administrative activity ----------

      match /activity/{eventId} {
        // Passive reads do not require recent authentication, but the reader
        // must still be an active, unbanned owner/admin of this exact company.
        allow get: if accountActive() && companyAdminOf(companyId);
        allow list: if accountActive()
          && companyAdminOf(companyId)
          && request.query.limit != null
          && request.query.limit <= 25;

        // Only the Admin SDK may append. Existing entries are immutable.
        allow create, update, delete: if false;
      }
    }

    // ---------- company name locks ----------
    //
    // One document per company name, keyed by a slug of the name. Firestore
    // cannot enforce uniqueness on a field, but a document id is unique by
    // definition — so allowing create and forbidding update turns this
    // collection into a uniqueness constraint that holds even when two people
    // register the same name at the same instant.

    match /companyNames/{slug} {
      // Uniqueness is enforced by create-only document IDs. The client does
      // not need to enumerate or inspect owner UID/name-lock metadata.
      allow read: if false;

      // Canonicalization happens in the verified-onboarding callable. Letting
      // a client choose this document id would let it omit or forge the lock.
      allow create: if false;

      // Never reassign a name — that is the whole constraint.
      allow update: if false;

      // Released only by whoever reserved it, and only as part of closing that
      // company down. Without this the name would stay locked for ever against
      // a company that no longer exists.
      allow delete: if accountActive()
        && resource.data.createdBy == uid()
        && !exists(
          /databases/$(database)/documents/companies/$(resource.data.companyId)
        );
    }

    // ---------- company member directory ----------

    // Company screens read only this projection. The private users collection
    // below contains email, birth date and notification tokens and is owner-only.
    match /memberDirectory/{userId} {
      function matchesPrivateProfileAfter() {
        return existsAfter(
          /databases/$(database)/documents/users/$(userId)
        )
        && validMemberProjection(request.resource.data)
        && memberProjectionEquals(
          request.resource.data,
          getAfter(/databases/$(database)/documents/users/$(userId)).data
        );
      }

      allow read: if sameCompany(resource.data.companyId);

      // A verified existing profile may join later. Initial onboarding uses
      // the trusted callable, which bypasses rules only after verifying Auth.
      allow create: if accountActive()
        && emailVerified()
        && userId == uid()
        && matchesPrivateProfileAfter()
        && exists(/databases/$(database)/documents/users/$(userId))
        && get(/databases/$(database)/documents/users/$(userId))
             .data.companyId == '';

      // A member may synchronize their own name. Administrative role and
      // approval changes are server-only so they cannot bypass activity.
      allow update: if accountActive()
        && request.resource.data.companyId == resource.data.companyId
        && matchesPrivateProfileAfter()
        && userId == uid();

      // A non-owner may still leave voluntarily. Administrative removal and
      // account deletion use trusted functions which bypass client rules.
      allow delete: if accountActive()
        && userId == uid()
        && exists(/databases/$(database)/documents/users/$(userId))
        && (
          !existsAfter(/databases/$(database)/documents/users/$(userId))
          || getAfter(/databases/$(database)/documents/users/$(userId))
               .data.companyId == ''
        );
    }

    // ---------- private user profiles ----------

    match /users/{userId} {
      function validUserDocument(data) {
        return data.keys().hasOnly([
            'membership',
            'fullName',
            'birthdate',
            'email',
            'role',
            'createdAt',
            'companyName',
            'companyId',
            'profileImage',
            'profileImageRevision',
            'fcmTokens',
            'notificationLocale',
            'pendingOnboardingType',
            'pendingCompanyName',
            'pendingCompanyId'
          ])
          && data.keys().hasAll([
            'membership', 'fullName', 'birthdate', 'email', 'role', 'createdAt',
            'companyId'
          ])
          && data.membership in ['active', 'pending']
          && data.fullName is string
          && data.fullName.size() > 0
          && data.fullName.size() <= 120
          && data.birthdate is string
          && data.birthdate.size() <= 50
          && data.email is string
          && data.email.size() <= 320
          && data.role in ['user', 'admin', 'moderator', 'superadmin']
          && data.createdAt is timestamp
          && data.companyId is string
          && (!('companyName' in data) || data.companyName is string)
          && (!('profileImage' in data) || data.profileImage is string)
          && (
            !('profileImageRevision' in data)
            || (
              data.profileImageRevision is int
              && data.profileImageRevision >= 0
              && data.profileImageRevision <= 2147483647
            )
          )
          && (
            !('fcmTokens' in data)
            || (data.fcmTokens is list && data.fcmTokens.size() <= 10)
          )
          && (
            !('notificationLocale' in data)
            || data.notificationLocale in ['en', 'de', 'sq']
          )
          && (
            !('pendingOnboardingType' in data)
            || data.pendingOnboardingType in ['createCompany', 'joinCompany']
          )
          && (
            !('pendingCompanyName' in data)
            || (
              data.pendingCompanyName is string
              && data.pendingCompanyName.size() > 0
              && data.pendingCompanyName.size() <= 120
            )
          )
          && (
            !('pendingCompanyId' in data)
            || (
              data.pendingCompanyId is string
              && data.pendingCompanyId.size() > 0
              && data.pendingCompanyId.size() <= 128
            )
          );
      }

      function validPendingRegistration(data) {
        return validUserDocument(data)
          && data.keys().hasOnly([
            'membership', 'fullName', 'birthdate', 'email', 'role',
            'createdAt', 'companyId', 'notificationLocale',
            'pendingOnboardingType', 'pendingCompanyName', 'pendingCompanyId'
          ])
          && data.companyId == ''
          && data.role == 'user'
          && data.membership == 'active'
          && 'pendingOnboardingType' in data
          && (
            (
              data.pendingOnboardingType == 'createCompany'
              && 'pendingCompanyName' in data
              && !('pendingCompanyId' in data)
            )
            || (
              data.pendingOnboardingType == 'joinCompany'
              && 'pendingCompanyId' in data
              && !('pendingCompanyName' in data)
            )
          );
      }

      // Private account data is owner-only. Company screens use the minimal
      // memberDirectory projection instead.
      allow read: if signedIn() && userId == uid();

      // Registration is deliberately private and inert. Before verification a
      // user may persist only this base profile plus one pending intent. It has
      // no tenant id, elevated role, member projection or public name lock.
      allow create: if accountActive()
        && userId == uid()
        && validPendingRegistration(request.resource.data)
        && memberProjectionSyncedAfter(userId, request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.email == request.auth.token.email;

      // You may edit your own harmless fields, join as a plain user, or leave
      // voluntarily if you are not the owner. Approval, role change and
      // administrative removal are trusted-only so the privilege mutation and
      // immutable activity event are one transaction.
      allow update: if accountActive() && emailVerified() && (
        // -- your own profile: name, birthday and notification preferences.
        // Avatar path/revision writes are server-only so a replacement and its
        // monotonic refresh signal cannot be separated or forged.
        (
          userId == uid()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'fullName', 'birthdate', 'fcmTokens', 'notificationLocale'
          ])
          && (
            !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['fullName'])
            || (
              request.resource.data.fullName is string
              && request.resource.data.fullName.size() > 0
              && request.resource.data.fullName.size() <= 120
            )
          )
          && (
            !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['birthdate'])
            || (
              request.resource.data.birthdate is string
              && request.resource.data.birthdate.size() <= 50
            )
          )
          && (
            !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['fcmTokens'])
            || (
              request.resource.data.fcmTokens is list
              && request.resource.data.fcmTokens.size() <= 10
            )
          )
          && (
            !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['notificationLocale'])
            || request.resource.data.notificationLocale in ['en', 'de', 'sq']
          )
        )

        // -- joining a company
        //
        // Only from having none, only as a plain user, only if that company has
        // not banned you, and only at whatever membership its policy dictates.
        // This is the path a banned or removed member takes to start again
        // somewhere else, which is why it exists at all.
        || (
          userId == uid()
          && resource.data.companyId == ''
          && request.resource.data.companyId != ''
          && !exists(
            /databases/$(database)/documents/memberDirectory/$(userId)
          )
          && request.resource.data.role == 'user'
          && companyAcceptsJoins(request.resource.data.companyId)
          && !bannedFrom(request.resource.data.companyId)
          && membershipOf(request.resource.data)
               == requiredJoinStatus(request.resource.data.companyId)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['companyId', 'role', 'membership'])
        )

        // -- leaving a company
        //
        // Available to a banned member, a pending one, or anyone who simply
        // wants out. The owner is excluded: a superadmin walking away would
        // leave their company with nobody able to administer it.
        || (
          userId == uid()
          && resource.data.role != 'superadmin'
          && request.resource.data.companyId == ''
          && request.resource.data.role == 'user'
          && membershipOf(request.resource.data) == 'active'
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['companyId', 'role', 'membership'])
        )
      ) && (
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'fullName', 'profileImage', 'profileImageRevision', 'companyId',
          'role', 'membership'
        ])
        || memberProjectionSyncedAfter(userId, request.resource.data)
      );

      // Account deletion is trusted and server-only. A client cannot prove it
      // also removed notes, votes, images, bans and Auth.
      allow delete: if false;

      // Rich-text note bodies. Strictly private.
      match /notes/{noteId} {
        allow read: if signedIn() && userId == uid();
        allow create, update: if accountActive() && userId == uid();
        // The list row and rich body are one logical note. Requiring the other
        // half to disappear in the same atomic request prevents old clients or
        // interrupted cleanup from creating a new orphan.
        allow delete: if accountActive()
          && userId == uid()
          && !existsAfter(
            /databases/$(database)/documents/notes/$(userId)/userNotes/$(noteId)
          );
      }
    }

    // ---------- notes ----------
    // Note titles and completion state. Also strictly private.

    match /notes/{userId} {
      allow read: if signedIn() && userId == uid();
      allow write: if accountActive() && userId == uid();

      match /userNotes/{noteId} {
        allow read: if signedIn() && userId == uid();
        allow create, update: if accountActive() && userId == uid();
        allow delete: if accountActive()
          && userId == uid()
          && !existsAfter(
            /databases/$(database)/documents/users/$(userId)/notes/$(noteId)
          );
      }
    }

    // ---------- surveys ----------

    match /surveys/{surveyId} {
      allow read: if sameCompany(resource.data.companyId);

      // The Admin SDK callable is the only survey-definition writer.
      allow create, update: if false;
      // The trusted deletion callable first establishes a server-owned parent
      // barrier and then removes every descendant and private key.
      allow delete: if false;

      // One submission per participant, keyed by uid.
      match /participants/{participantId} {
        function surveyCompanyId() {
          return get(/databases/$(database)/documents/surveys/$(surveyId))
                   .data.companyId;
        }

        function surveyOpen() {
          return get(/databases/$(database)/documents/surveys/$(surveyId))
                   .data.deadline is timestamp
            && request.time <= get(
              /databases/$(database)/documents/surveys/$(surveyId)
            ).data.deadline;
        }

        function surveyAcceptsParticipantWrites() {
          return !('deletionStartedAt' in get(
            /databases/$(database)/documents/surveys/$(surveyId)
          ).data);
        }

        function validSubmission(data) {
          return data.keys().hasOnly([
              'userId',
              'name',
              'answers',
              'score',
              'submittedAt',
              'participantSubmitted',
              'imageProfile',
              'profileImageRevision',
              'textAnswersReviewed',
              'totalCorrectAnswers',
              'gradedQuestionCount',
              'gradingStatus'
            ])
            && data.keys().hasAll([
              'userId', 'name', 'answers', 'score', 'submittedAt',
              'participantSubmitted', 'imageProfile', 'textAnswersReviewed',
              'profileImageRevision', 'totalCorrectAnswers',
              'gradedQuestionCount', 'gradingStatus'
            ])
            && data.userId == uid()
            && callerUsesCanonicalMemberName(surveyCompanyId(), data.name)
            && data.answers is map
            && data.answers.size() <= 100
            // Only the server-side grading trigger may replace these sentinels.
            && data.score == 0
            && data.submittedAt == request.time
            && data.participantSubmitted == true
            // A response may snapshot only the caller's canonical Storage
            // path, never a bearer-token URL or an arbitrary remote image.
            && data.imageProfile in [
              '', canonicalProfileImagePath(uid())
            ]
            && data.profileImageRevision is int
            && data.profileImageRevision >= 0
            && data.profileImageRevision <= 2147483647
            && data.textAnswersReviewed is map
            && data.textAnswersReviewed.size() == 0
            && data.totalCorrectAnswers == 0
            && data.gradedQuestionCount == 0
            && data.gradingStatus == 'processing';
        }

        // Participants see their own result; admins see everyone's.
        allow read: if signedIn()
          && (
            (participantId == uid() && sameCompany(surveyCompanyId()))
            || adminOf(surveyCompanyId())
          );

        // You submit your own answers, under your own id, once.
        allow create: if accountActive()
          && surveyAcceptsParticipantWrites()
          && participantId == uid()
          && validSubmission(request.resource.data)
          && sameCompany(surveyCompanyId())
          && exists(
            /databases/$(database)/documents/surveyAnswerKeys/$(surveyId)
          )
          && surveyOpen();

        // Staff supplies only free-text verdicts. A trusted update trigger
        // derives the complete score and correct-answer total atomically.
        // No client, including an admin client, may author those totals.
        allow update: if accountActive()
          && surveyAcceptsParticipantWrites()
          && adminOf(surveyCompanyId())
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'textAnswersReviewed'
          ])
          && request.resource.data.textAnswersReviewed is map
          && request.resource.data.textAnswersReviewed.size() <= 100
          && request.resource.data.textAnswersReviewed.values().hasOnly([
            true, false
          ]);

        // A submitted response is a durable record. Staff may remove somebody
        // else's response, but nobody can erase their own submission.
        allow delete: if accountActive()
          && surveyAcceptsParticipantWrites()
          && participantId != uid()
          && adminOf(surveyCompanyId());
      }
    }

    // Grading material, written only by the publication callable and immutable
    // afterwards. Cloud Functions use the Admin SDK and are not subject to
    // these client rules.
    match /surveyAnswerKeys/{surveyId} {
      // Staff only, and only inside their own company.
      //
      // They wrote these answers, and reviewing a submission means showing
      // which option was right. Participants are refused, which is the part
      // that matters: the key stays unreadable to anyone who could still be
      // sitting the test. Grading is unaffected either way - that runs in a
      // trusted function against this same document.
      allow read: if accountActive() && adminOf(resource.data.companyId);

      allow create, update: if false;

      allow delete: if false;
    }

    // ---------- appointments ----------

    match /appointments/{appointmentId} {
      function validAppointmentDocument(data) {
        return data.keys().hasOnly([
            'schemaVersion',
            'revision',
            'appointmentId',
            'companyId',
            'createdBy',
            'title',
            'description',
            'zoneId',
            'expirationAt',
            'slots',
            'slotIds',
            'confirmedSlotId',
            'participantUserIds',
            'createdAt',
            'deletionStartedAt'
          ])
          && data.keys().hasAll([
            'schemaVersion', 'revision', 'appointmentId', 'companyId',
            'createdBy', 'title', 'description', 'zoneId', 'expirationAt',
            'slots', 'slotIds', 'confirmedSlotId', 'participantUserIds',
            'createdAt'
          ])
          && data.schemaVersion == 2
          && data.revision is int
          && data.revision >= 1
          && data.revision <= 9007199254740991
          && data.appointmentId == appointmentId
          && data.companyId is string
          && data.companyId.size() > 0
          && data.companyId.size() <= 128
          && data.createdBy is string
          && data.createdBy.size() > 0
          && data.createdBy.size() <= 128
          && data.title is string
          && data.title.size() > 0
          && data.title.size() <= 160
          && data.description is string
          && data.description.size() > 0
          && data.description.size() <= 5000
          && data.zoneId is string
          && data.zoneId.size() > 0
          && data.zoneId.size() <= 128
          && data.expirationAt is timestamp
          && data.slots is list
          && data.slots.size() > 0
          && data.slots.size() <= 100
          && data.slotIds is list
          && data.slotIds.size() == data.slots.size()
          && data.slotIds.toSet().size() == data.slotIds.size()
          && (
            data.confirmedSlotId == null
            || (
              data.confirmedSlotId is string
              && data.confirmedSlotId in data.slotIds
            )
          )
          && data.participantUserIds is list
          && data.participantUserIds.toSet().size()
               == data.participantUserIds.size()
          && data.createdAt is timestamp
          && (
            !('deletionStartedAt' in data)
            || data.deletionStartedAt is timestamp
          );
      }

      function appointmentAcceptsVotes(data) {
        return validAppointmentDocument(data)
          && !('deletionStartedAt' in data)
          && data.confirmedSlotId == null
          && data.expirationAt is timestamp
          && request.time < data.expirationAt;
      }

      allow get: if validAppointmentDocument(resource.data)
        && sameCompany(resource.data.companyId);
      // Collection queries must constrain both tenant and canonical schema.
      // Parent writes are trusted-only, so these two filters bound every
      // possible result to this caller's clean v2 appointment set.
      allow list: if resource.data.schemaVersion == 2
        && sameCompany(resource.data.companyId);

      // Canonical creation and content edits are owned by the trusted callable.
      allow create: if false;
      allow delete: if false;

      // Staff may only make the one latency-sensitive transition directly.
      // Clearing/reopening and all content edits return to the callable.
      // Definition edits and confirmation are trusted-only so the immutable
      // activity entry and the appointment revision change commit together.
      allow update: if false;

      // Participant ids are stable '<uid>-<slotId>' keys.
      match /participants/{participantId} {
        function appointmentData() {
          return get(
            /databases/$(database)/documents/appointments/$(appointmentId)
          ).data;
        }

        function appointmentCompanyId() {
          return appointmentData().companyId;
        }

        function appointmentOpen() {
          return appointmentAcceptsVotes(appointmentData());
        }

        function appointmentAcceptsParticipantWrites() {
          return !('deletionStartedAt' in appointmentData());
        }

        function validVote(data) {
          return data.keys().hasOnly([
              'userId', 'userName', 'slotId', 'status', 'participated'
            ])
            && data.keys().hasAll([
              'userId', 'userName', 'slotId', 'status', 'participated'
            ])
            && callerUsesCanonicalMemberName(
              appointmentCompanyId(),
              data.userName
            )
            && data.slotId is string
            && data.slotId in appointmentData().slotIds
            && data.status in ['joined', 'maybe', 'declined']
            && data.userId == uid()
            && data.participated == true
            && participantId == uid() + '-' + data.slotId;
        }

        // Everyone in the company can see who is coming to a meeting.
        allow read: if sameCompany(appointmentCompanyId());

        allow create: if accountActive()
          && validVote(request.resource.data)
          && sameCompany(appointmentCompanyId())
          && appointmentOpen();

        allow update: if accountActive()
          && resource.data.userId == uid()
          && validVote(request.resource.data)
          && sameCompany(appointmentCompanyId())
          && appointmentOpen();

        allow delete: if accountActive()
          && appointmentAcceptsParticipantWrites()
          && (
            (
              resource.data.userId == uid()
              && sameCompany(appointmentCompanyId())
              && appointmentOpen()
            )
            || adminOf(appointmentCompanyId())
          );
      }
    }

    // Anything not matched above is denied. Adding a collection means adding a
    // rule for it here, deliberately.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
