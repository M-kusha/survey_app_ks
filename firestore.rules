rules_version = '2';

// EchoMeet security rules.
//
// The app is multi-tenant: every user belongs to a company, and nothing should
// ever cross that boundary. The client-side role checks in the Flutter code
// (FirebaseServices.fetchAdminStatus and friends) only decide which buttons to
// draw — they are not a security boundary and are trivially bypassed. This file
// is the boundary.
//
// Two rules carry most of the weight:
//   * a user can never change their own role
//   * a participant can never write their own score
//
// Note on cost: helper functions below use get() to read the caller's profile.
// Each get() counts as a document read and Firestore allows 10 per single-doc
// request. The helpers are written so a request needs at most two.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------

    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(uid())).data;
    }

    // A banned member is signed in and has a profile, and is still refused
    // everything that goes through here — reading the company's surveys,
    // answering one, voting on a meeting. The one thing left open is their own
    // user document, so the app can tell them why nothing works.
    //
    // Written as an `in` test rather than `profile().banned != true` because
    // reading a field that was never written is an error in rules, and every
    // account created before this existed has no such field.
    function notBanned() {
      return !('banned' in profile()) || profile().banned != true;
    }

    function hasProfile() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(uid()))
        && notBanned();
    }

    function myCompanyId() {
      return profile().companyId;
    }

    // Two levels of privilege, deliberately separate.
    //
    // `isStaff` is about *content* — writing surveys and meetings, seeing
    // results, marking written answers. Moderators are staff.
    //
    // `isCompanyAdmin` is about *people* — roles, bans, removals. Moderators
    // are not, and that is the whole point: a moderator who can promote is an
    // admin with extra steps. This split is enforced here rather than in the
    // UI, because a rule is the only version of it an attacker cannot skip.
    function isStaff() {
      return hasProfile()
        && profile().role in ['admin', 'moderator', 'superadmin'];
    }

    function isCompanyAdmin() {
      return hasProfile()
        && profile().role in ['admin', 'superadmin'];
    }

    // Same company as the caller, *and* entitled to be there.
    //
    // A null companyId never matches, so documents written before companyId
    // existed stay invisible rather than public. Pending and banned members
    // fail here too, which is the whole access model in one function: they can
    // sign in, keep their notes and go and find another company, but the
    // content of this one is closed to them.
    function sameCompany(companyId) {
      return activeIn(companyId);
    }

    /// Content privilege inside one company. Named `adminOf` throughout the
    /// content rules below; it includes moderators.
    function adminOf(companyId) {
      return isStaff() && sameCompany(companyId);
    }

    /// People privilege inside one company. Admins and the owner only.
    function companyAdminOf(companyId) {
      return isCompanyAdmin() && sameCompany(companyId);
    }

    // True when the caller created this company, which is how "I am registering
    // my own company" is told apart from "I am joining someone else's".
    function createdCompany(companyId) {
      return companyId != null
        && exists(/databases/$(database)/documents/companies/$(companyId))
        && get(/databases/$(database)/documents/companies/$(companyId))
             .data.createdBy == uid();
    }

    function fieldUnchanged(field) {
      return request.resource.data[field] == resource.data[field];
    }

    // ---------- membership ----------
    //
    // A ban is a document under the company, not a flag on the person:
    // `companies/{c}/bans/{uid}`. That is what lets the account outlive it. The
    // banned member keeps their login, their notes and their ability to go and
    // join somewhere else, and the company keeps a list it can work from — one
    // it does not lose the moment that person moves on, which a flag on the
    // user document would.
    function bannedFrom(companyId) {
      return companyId != null
        && companyId != ''
        && exists(
             /databases/$(database)/documents/companies/$(companyId)/bans/$(uid())
           );
    }

    // Joining is either immediate or it waits, and the company decides which.
    // A missing `joinPolicy` reads as open, so companies created before this
    // existed keep behaving exactly as they did.
    function joinPolicyOf(companyId) {
      return 'joinPolicy' in get(
               /databases/$(database)/documents/companies/$(companyId)
             ).data
        ? get(/databases/$(database)/documents/companies/$(companyId))
            .data.joinPolicy
        : 'open';
    }

    // What a new joiner's membership must be set to. Written as a rule rather
    // than trusted from the client: otherwise anyone could join a company that
    // requires approval and mark themselves approved in the same write.
    function requiredJoinStatus(companyId) {
      return joinPolicyOf(companyId) == 'open' ? 'active' : 'pending';
    }

    // Absent means active, so accounts that predate approvals are unaffected.
    function membershipOf(data) {
      return 'membership' in data ? data.membership : 'active';
    }

    // Full access to a company's content: a member, approved, not banned.
    function activeIn(companyId) {
      return hasProfile()
        && companyId != null
        && companyId != ''
        && myCompanyId() == companyId
        && membershipOf(profile()) == 'active'
        && !bannedFrom(companyId);
    }

    // ---------- companies ----------

    match /companies/{companyId} {
      // Deliberately readable without signing in.
      //
      // The "join an existing company" step lists companies so the user can
      // pick one, and it runs before the account is created — requiring auth
      // here silently returns an empty list and makes that path impossible.
      //
      // This is a real tradeoff, not an oversight: anyone can enumerate company
      // names. They are not secrets, and nothing else about a company is stored
      // here. The proper fix is to create the auth account at the *start* of
      // registration rather than the end, after which this can require auth
      // again. Tracked with the registration rework.
      allow read: if true;

      allow create: if signedIn()
        && request.resource.data.createdBy == uid()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0;

      // Renaming a company is a superadmin action and must never reassign
      // ownership.
      // The join policy is people-work, not content-work, so a moderator may
      // not flip a company open.
      //
      // Scheduling or calling off the company's own destruction is narrower
      // still: only the person who created it. An admin runs the place; ending
      // it is the owner's alone.
      allow update: if companyAdminOf(companyId)
        && fieldUnchanged('createdBy')
        && (
          !('joinPolicy' in request.resource.data)
          || request.resource.data.joinPolicy in ['open', 'approval']
        )
        && (
          ('deletionScheduledFor' in request.resource.data)
            == ('deletionScheduledFor' in resource.data)
          || resource.data.createdBy == uid()
        );

      // A company can only be destroyed by its owner, only after being
      // scheduled, and only once the week has actually run out.
      //
      // The waiting period is enforced here rather than left to a countdown in
      // the app. A grace period that exists only in the client is a grace
      // period until somebody sends the request themselves — and this one
      // deletes everybody's work, not just the owner's.
      allow delete: if companyAdminOf(companyId)
        && resource.data.createdBy == uid()
        && 'deletionScheduledFor' in resource.data
        && request.time >= resource.data.deletionScheduledFor;

      // ---------- bans ----------
      //
      // One document per banned person, under the company that banned them.
      match /bans/{bannedUserId} {
        // The person themselves can read their own ban, which is how the app
        // can say "you are banned from Acme" instead of failing silently and
        // looking broken. Staff can read the whole list — that is the list an
        // admin unbans people from.
        allow read: if signedIn()
          && (bannedUserId == uid() || adminOf(companyId));

        // Writing one is admin-only, and a ban may not be aimed at yourself:
        // an admin who bans themselves locks their own company.
        allow create, delete: if companyAdminOf(companyId)
          && bannedUserId != uid();

        // Nothing to amend. Lifting a ban is a delete.
        allow update: if false;
      }
    }

    // ---------- company name locks ----------
    //
    // One document per company name, keyed by a slug of the name. Firestore
    // cannot enforce uniqueness on a field, but a document id is unique by
    // definition — so allowing create and forbidding update turns this
    // collection into a uniqueness constraint that holds even when two people
    // register the same name at the same instant.

    match /companyNames/{slug} {
      // Readable for the same reason as companies: the client checks
      // availability before the account exists, to give a useful message.
      allow read: if true;

      allow create: if signedIn()
        && request.resource.data.createdBy == uid()
        && request.resource.data.companyId is string;

      // Never reassign a name — that is the whole constraint.
      allow update: if false;

      // Released only by whoever reserved it, and only as part of closing that
      // company down. Without this the name would stay locked for ever against
      // a company that no longer exists.
      allow delete: if signedIn() && resource.data.createdBy == uid();
    }

    // ---------- users ----------

    match /users/{userId} {
      // Your own profile, or a colleague's — the app shows participant names
      // and avatars, and user management lists the company's members.
      allow read: if signedIn()
        && (userId == uid() || sameCompany(resource.data.companyId));

      // Sign-up writes this document. 'superadmin' is only accepted when the
      // companyId names a company this same user just created; joining an
      // existing company forces 'user'. Without this, anyone could pick any
      // company at sign-up and hand themselves admin over it.
      //
      // A new member's `membership` is dictated by the company's join policy,
      // not chosen by the client — otherwise "approval required" would be a
      // suggestion that anyone could decline by editing one field of their own
      // sign-up payload. Someone already banned from a company cannot register
      // straight back into it either.
      allow create: if signedIn()
        && userId == uid()
        && (
          (
            request.resource.data.role == 'user'
            && (
              request.resource.data.companyId == ''
              || (
                !bannedFrom(request.resource.data.companyId)
                && membershipOf(request.resource.data)
                     == requiredJoinStatus(request.resource.data.companyId)
              )
            )
          )
          || (
            request.resource.data.role == 'superadmin'
            && createdCompany(request.resource.data.companyId)
            && membershipOf(request.resource.data) == 'active'
          )
        );

      // You may edit your own profile but never your own role or company.
      // An admin may change a *colleague's* role, but not their company, and
      // may not grant superadmin.
      //
      // The `userId != uid()` on the second branch is load-bearing. Without it
      // the two branches were an OR, so an admin editing their own document
      // satisfied the admin branch — which carries no `fieldUnchanged('role')`
      // — and could award themselves any role they liked. Since `isAdmin()`
      // includes moderators, that was a path from the lowest elevated role
      // straight to superadmin.
      //
      // Restricting the assignable set closes the other half: superadmin means
      // "created this company", which is established at sign-up by
      // createdCompany() and must not be grantable afterwards by anyone.
      allow update: if signedIn() && (
        // -- your own profile: name, birthday, avatar
        (
          userId == uid()
          && fieldUnchanged('role')
          && fieldUnchanged('companyId')
          // Approving yourself would make "approval required" meaningless.
          && membershipOf(request.resource.data) == membershipOf(resource.data)
        )

        // -- joining a company
        //
        // Only from having none, only as a plain user, only if that company has
        // not banned you, and only at whatever membership its policy dictates.
        // This is the path a banned or removed member takes to start again
        // somewhere else, which is why it exists at all.
        || (
          userId == uid()
          && resource.data.companyId == ''
          && request.resource.data.companyId != ''
          && request.resource.data.role == 'user'
          && !bannedFrom(request.resource.data.companyId)
          && membershipOf(request.resource.data)
               == requiredJoinStatus(request.resource.data.companyId)
        )

        // -- leaving a company
        //
        // Available to a banned member, a pending one, or anyone who simply
        // wants out. The owner is excluded: a superadmin walking away would
        // leave their company with nobody able to administer it.
        || (
          userId == uid()
          && resource.data.role != 'superadmin'
          && request.resource.data.companyId == ''
          && request.resource.data.role == 'user'
        )

        // -- an admin managing a colleague
        //
        // Roles, and approving a pending join. `adminOf` would have let a
        // moderator promote people, which is the line the user drew and the
        // reason `companyAdminOf` is a separate function.
        || (
          userId != uid()
          && companyAdminOf(resource.data.companyId)
          && fieldUnchanged('companyId')
          && request.resource.data.role in ['admin', 'moderator', 'user']
          && membershipOf(request.resource.data) in ['active', 'pending']
        )

        // -- an admin removing a colleague
        //
        // The one case where somebody else may change your company, and only
        // ever to empty. Anything else would be moving a colleague into another
        // company without their say.
        || (
          userId != uid()
          && companyAdminOf(resource.data.companyId)
          && request.resource.data.companyId == ''
          && request.resource.data.role == 'user'
        )
      );

      // Account deletion, from AccountDeletionService.
      allow delete: if signedIn() && userId == uid();

      // Rich-text note bodies. Strictly private.
      match /notes/{noteId} {
        allow read, write: if signedIn() && userId == uid();
      }
    }

    // ---------- notes ----------
    // Note titles and completion state. Also strictly private.

    match /notes/{userId} {
      allow read, write: if signedIn() && userId == uid();

      match /userNotes/{noteId} {
        allow read, write: if signedIn() && userId == uid();
      }
    }

    // ---------- surveys ----------

    match /surveys/{surveyId} {
      allow read: if sameCompany(resource.data.companyId);

      // Only admins author surveys, and only inside their own company.
      allow create: if adminOf(request.resource.data.companyId);
      allow update: if adminOf(resource.data.companyId)
        && fieldUnchanged('companyId');
      allow delete: if adminOf(resource.data.companyId);

      // One submission per participant, keyed by uid.
      match /participants/{participantId} {
        function surveyCompanyId() {
          return get(/databases/$(database)/documents/surveys/$(surveyId))
                   .data.companyId;
        }

        // Participants see their own result; admins see everyone's.
        allow read: if signedIn()
          && (participantId == uid() || adminOf(surveyCompanyId()));

        // You submit your own answers, under your own id, once.
        allow create: if signedIn()
          && participantId == uid()
          && request.resource.data.userId == uid()
          && sameCompany(surveyCompanyId());

        // Grading is an admin action. A participant must never be able to
        // rewrite their own score or correct-answer count after submitting —
        // that is the whole point of scoring server-side of the client.
        allow update: if adminOf(surveyCompanyId());

        allow delete: if signedIn()
          && (participantId == uid() || adminOf(surveyCompanyId()));
      }
    }

    // ---------- appointments ----------

    match /appointments/{appointmentId} {
      allow read: if sameCompany(resource.data.companyId);

      allow create: if adminOf(request.resource.data.companyId);
      allow delete: if adminOf(resource.data.companyId);

      // Editing the appointment itself stays with admins. Voting, though, has
      // to write to this document — the set of people who have answered lives
      // here — so a colleague may make exactly one change: adding their own uid
      // to participantUserIds.
      //
      // Everything is pinned down: no other field may change, nobody may be
      // removed, and the only id that may appear is the caller's own. Without
      // the admin-only rule being relaxed like this, a non-admin's vote was
      // rejected outright.
      allow update: if (
        adminOf(resource.data.companyId) && fieldUnchanged('companyId')
      ) || (
        sameCompany(resource.data.companyId)
        && request.resource.data.diff(resource.data)
             .affectedKeys().hasOnly(['participantUserIds'])
        && request.resource.data.participantUserIds
             .hasAll(resource.data.participantUserIds)
        && request.resource.data.participantUserIds.toSet()
             .difference(resource.data.participantUserIds.toSet())
             .hasOnly([uid()])
      );

      // Participant ids here are '<uid>-<slotStart>-<slotEnd>', so ownership is
      // asserted through the userId field rather than the document id.
      match /participants/{participantId} {
        function appointmentCompanyId() {
          return get(/databases/$(database)/documents/appointments/$(appointmentId))
                   .data.companyId;
        }

        // Everyone in the company can see who is coming to a meeting.
        allow read: if sameCompany(appointmentCompanyId());

        allow create, update: if signedIn()
          && request.resource.data.userId == uid()
          && sameCompany(appointmentCompanyId());

        allow delete: if signedIn()
          && (
            resource.data.userId == uid()
            || adminOf(appointmentCompanyId())
          );
      }
    }

    // Anything not matched above is denied. Adding a collection means adding a
    // rule for it here, deliberately.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
