# Apache config for hosting the built app outside Firebase.
#
# Anything in web/ is copied verbatim into build/web/, so this ships with every
# build and needs no separate upload step. Harmless on hosts that ignore it.
#
# Two problems it solves, both of which are silent failures.

# 1. Refreshing on any route 404s.
#
# The app is one HTML file; routes are handled in the browser. A shared host
# asked for /settings looks for a file called "settings", does not find one, and
# serves its own 404 page. The app works perfectly until somebody reloads or
# opens a link directly, which is exactly what a reviewer will do.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Real files and directories are served as-is. Everything else is the app.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  RewriteRule ^ index.html [L]
</IfModule>

# 2. Visitors get stuck on an old build for ever.
#
# Flutter's web shell uses stable filenames such as main.dart.js and
# flutter_bootstrap.js. Caching those as immutable can pin a visitor to a
# broken or obsolete release even after the server has been updated.
<IfModule mod_headers.c>
  <FilesMatch "^(index\.html|flutter\.js|flutter_bootstrap\.js|main\.dart\.js|flutter_service_worker\.js|firebase-messaging-sw\.js|version\.json|manifest\.json)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>

  <FilesMatch "\.(js|css|wasm|ttf|otf|woff2?|png|jpg|jpeg|svg|json)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>

  # Undo the above for the files that must stay fresh — FilesMatch order is not
  # guaranteed to favour the first block.
  <FilesMatch "^(flutter\.js|flutter_bootstrap\.js|main\.dart\.js|flutter_service_worker\.js|firebase-messaging-sw\.js|version\.json|manifest\.json)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
  AddType application/wasm .wasm
  AddType application/manifest+json .webmanifest
</IfModule>

# Compression matters more here than on an ordinary site. The renderer is a 7MB
# .wasm and the app is a 6MB .js; served raw that is a 13MB first visit, and
# `application/wasm` is not in anybody's default compression list.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript \
    application/json image/svg+xml application/wasm font/ttf font/otf
</IfModule>
