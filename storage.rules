rules_version = '2';

// EchoMeet Storage rules.
//
// The bucket holds exactly one kind of object: profile pictures, one per user,
// at profile_images/<uid>.jpg. Anything else is denied.

service firebase.storage {
  match /b/{bucket}/o {

    match /profile_images/{fileName} {
      // Avatars are shown next to survey and appointment participants, so any
      // signed-in user can read them. They are not public: an unauthenticated
      // request gets nothing.
      allow read: if request.auth != null;

      // You may only write your own, and only an image, and only a small one.
      // Without the size cap the bucket is a free file host for anyone with an
      // account; without the content-type check it will happily store anything
      // renamed to .jpg.
      allow write: if request.auth != null
        && fileName == request.auth.uid + '.jpg'
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      allow delete: if request.auth != null
        && fileName == request.auth.uid + '.jpg';
    }

    // Nothing else belongs in this bucket.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
